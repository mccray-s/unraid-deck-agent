<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name "UnraidDeck">
<!ENTITY author "mccray">
<!ENTITY version "2026.10.28a">
<!ENTITY launch "Settings/Notifications">
<!ENTITY plugdir "/usr/local/emhttp/plugins/&name;">
<!ENTITY github "mccray-s/unraid-deck-agent">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/&name;.plg">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.11.0" support="https://forums.unraid.net/topic/198651-plugin-unraid-deck-notification-agent/" icon="unraiddeck.png">

<CHANGES>
###2026.10.28a
- Fix: Display the plugin icon in the installed plugins list.

###2026.10.28
- Change: Update plugin icon.

###2026.10.10
- Security: Add SHA256 integrity checks for the downloaded notification agent and icon.

###2026.05.07
- Change: Update support URL to the official Unraid forum plugin topic.
- Change: Update plugin icon.

###2026.03.25
- Fix: Restore plugin internal name to `UnraidDeck` to resolve plugin update status stuck on "checking".
- Add: Add legacy compatibility entry file `Unraid Deck.plg` for older install URLs.

###2026.03.20
- Change: Update JSON payload.

###2026.03.16
- Feature: Removed 'event' field and simplified to 'subject', 'description', and 'importance'.
- Change: Changed from "UnraidDeck" to "Unraid Deck".

###2026.03.11
- Initial Release: Core notification push logic for Unraid Deck iOS app.
</CHANGES>

<!--
The 'pre-install' script.
Cleans up any potential previous installation directories.
-->
<FILE Run="/bin/bash">
<INLINE>
rm -rf /boot/config/plugins/&name;
mkdir -p /boot/config/plugins/&name;
echo "Installing Unraid Deck Notification Agent..."
</INLINE>
</FILE>

<!--
Download the Agent XML file directly from Github
This replaces the old Base64 inline method.
-->
<FILE Name="/usr/local/emhttp/plugins/dynamix/agents/UnraidDeck.xml">
<URL>https://raw.githubusercontent.com/&github;/main/plugins/dynamix/agents/UnraidDeck.xml</URL>
<SHA256>c769dad755f3d1744439eec2442d1fc9fcd25dae7d2fe02dbcc222702ee2bc7a</SHA256>
</FILE>

<!--
Download the icon file from Github
-->
<FILE Name="/usr/local/emhttp/plugins/dynamix/icons/unraiddeck.png">
<URL>https://raw.githubusercontent.com/&github;/main/plugins/dynamix/icons/unraiddeck.png</URL>
<SHA256>5d0a80c03e96648fb7a0045a4abb32be8dea590d4729b1737d54a86093fab34e</SHA256>
</FILE>

<!--
The 'post-install' script.
Ensures execution permissions and provides user feedback.
-->
<FILE Run="/bin/bash">
<INLINE>
chmod +x /usr/local/emhttp/plugins/dynamix/agents/UnraidDeck.xml
# Reuse the verified notification agent PNG in the plugin list's icon directory.
mkdir -p "&plugdir;/images" || exit 1
cp /usr/local/emhttp/plugins/dynamix/icons/unraiddeck.png "&plugdir;/images/unraiddeck.png" || exit 1
echo ""
echo "----------------------------------------------------"
echo " &name; Agent has been successfully installed."
echo " Version: &version;"
echo " Go to Settings -> Notifications -> Agents to configure."
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!--
The 'remove' script.
Executed when the user uninstalls the plugin from the WebUI.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
# Remove runtime files
rm -rf /usr/local/emhttp/plugins/dynamix/agents/UnraidDeck.xml
rm -rf /usr/local/emhttp/plugins/dynamix/icons/unraiddeck.png
# Remove only the plugin list icon and empty directories, preserving other files.
rm -f "&plugdir;/images/unraiddeck.png"
rmdir "&plugdir;/images" "&plugdir;" 2>/dev/null
# Remove persistent config directory (even if currently empty, this is best practice)
rm -rf /boot/config/plugins/&name;

echo ""
echo "----------------------------------------------------"
echo " &name; Agent has been removed."
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

</PLUGIN>
